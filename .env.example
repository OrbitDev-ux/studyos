# Database (Supabase Postgres)
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`/`generate`.
# Both are on the Supabase dashboard under Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase JS SDK (lib/supabase/*) — Project Settings > API on the dashboard.
# For local dev via `supabase start`, use its printed API_URL and the fixed
# local anon key (safe to keep as-is; it's Supabase's public local-dev demo key).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini (AI 문제 생성/오답 분석 등)
GEMINI_API_KEY=""

# Admin panel (/admin-auth) — shared passphrase, not a per-user account.
# ADMIN_SECRET: the passphrase itself, compared server-side only.
# ADMIN_SESSION_SECRET: separate signing key for the admin session cookie,
# kept apart from AUTH_SECRET so a leak of one doesn't compromise the other.
# Generate both with: openssl rand -base64 32
ADMIN_SECRET=""
ADMIN_SESSION_SECRET=""
