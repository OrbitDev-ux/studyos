# Database (Supabase Postgres)
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`/`generate`.
# Both are on the Supabase dashboard under Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini (AI 문제 생성/오답 분석 등)
GEMINI_API_KEY=""
