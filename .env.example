# Database (Supabase Postgres)
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`/`generate`.
# Both are on the Supabase dashboard under Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase JS SDK (lib/supabase/*) — Project Settings > API on the dashboard.
# For local dev via `supabase start`, use its printed API_URL and the fixed
# local anon key (safe to keep as-is; it's Supabase's public local-dev demo key).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Auth.js
# AUTH_SECRET: 세션 서명 키. 없으면 로그인 불가. `openssl rand -base64 33`로 생성.
# AUTH_URL: 배포 시 반드시 실제 프로덕션 도메인(https://...)으로. 인증 콜백뿐 아니라
#   SEO 절대 URL(robots.txt/sitemap.xml/OpenGraph/JSON-LD)이 이 값을 기준으로 생성되므로,
#   틀리면 검색/공유 링크가 전부 어긋난다. (src/lib/site-url.ts)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# AI Provider 선택: "groq"(기본) | "gemini". 값에 따라 아래 해당 키가 필요하다.
AI_PROVIDER="groq"

# Groq API (기본 AI Provider). 서버 전용 — 절대 NEXT_PUBLIC_/클라이언트 노출 금지.
# OpenAI 호환 Chat Completions + strict structured output(json_schema).
GROQ_API_KEY=""
# (선택) Groq 모델 override. 기본 openai/gpt-oss-120b (strict structured output 지원).
GROQ_MODEL=""

# Google Gemini (AI_PROVIDER=gemini 일 때만 사용). 서버 전용.
GEMINI_API_KEY=""

# Google AdSense (Trial 사용자에게만 광고 노출; features/ads)
# 미설정 시 AdSlot 은 개발용 placeholder 를 렌더하며 실제 광고 요청을 하지 않음.
# 실제 광고는 AdSense 승인 + 운영(NODE_ENV=production) 환경에서만 로드됨.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID 예: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_DASHBOARD_SLOT=""
NEXT_PUBLIC_ADSENSE_RESULT_SLOT=""
NEXT_PUBLIC_ADSENSE_MOCK_EXAM_SLOT=""
NEXT_PUBLIC_ADSENSE_REVIEW_SLOT=""

# Admin panel (/admin-auth)
# ADMIN_SECRET: bootstrap passphrase. Entering it signs in as the SUPER_ADMIN
#   account (created on first use), which can then add further admins that log
#   in with email + password. Compared server-side only.
# ADMIN_SESSION_SECRET: separate signing key for the admin session cookie,
#   kept apart from AUTH_SECRET so a leak of one doesn't compromise the other.
# ADMIN_BOOTSTRAP_EMAIL: email assigned to the bootstrap SUPER_ADMIN account
#   (optional; defaults to root@studyos.local). You can also sign in via the
#   credential form using this email and ADMIN_SECRET as the password.
# Generate the secrets with: openssl rand -base64 32
ADMIN_SECRET=""
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL=""

# Sentry (에러 모니터링; features/instrumentation)
# 미설정 시 Sentry SDK 는 완전 무동작(no-op) — 로컬/개발에서 아무 부작용 없음.
# SENTRY_DSN: 서버/엣지 런타임 에러 전송용(비공개).
# NEXT_PUBLIC_SENTRY_DSN: 브라우저 에러 전송용(클라이언트 번들에 포함되는 공개 값).
#   보통 같은 프로젝트의 DSN을 두 곳에 동일하게 넣는다.
# SENTRY_ORG / SENTRY_PROJECT / SENTRY_AUTH_TOKEN: 빌드 시 소스맵 업로드용(선택).
#   AUTH_TOKEN 이 없으면 소스맵 업로드만 생략되고 빌드는 정상 동작한다.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Study OS Dev — Runtime Backend (features/dev). A SEPARATE service (see
# dev-runtime/README.md) — Vercel has no Docker daemon, so this app only
# talks to it over HTTPS/WSS. Unset DEV_RUNTIME_URL = honest v1 default
# (UnavailableContainerManager; /dev/* shows "backend not connected").
# DEV_RUNTIME_URL: e.g. https://dev-runtime.your-domain.com
# DEV_RUNTIME_WS_URL: optional override if the WS endpoint has a different host.
# DEV_RUNTIME_SERVICE_TOKEN / DEV_RUNTIME_CAPABILITY_SECRET: MUST exactly
#   match the same-named vars in dev-runtime's own .env (openssl rand -base64 32).
DEV_RUNTIME_URL=""
DEV_RUNTIME_WS_URL=""
DEV_RUNTIME_SERVICE_TOKEN=""
DEV_RUNTIME_CAPABILITY_SECRET=""
