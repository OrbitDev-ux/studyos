# Database (Supabase Postgres)
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the app at runtime.
# DIRECT_URL: direct connection (port 5432) — used only by `prisma migrate`/`generate`.
# Both are on the Supabase dashboard under Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Supabase JS SDK (lib/supabase/*) — Project Settings > API on the dashboard.
# For local dev via `supabase start`, use its printed API_URL and the fixed
# local anon key (safe to keep as-is; it's Supabase's public local-dev demo key).
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Auth.js
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Google OAuth
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Google Gemini (AI 문제 생성/오답 분석 등)
GEMINI_API_KEY=""

# Google AdSense (Trial 사용자에게만 광고 노출; features/ads)
# 미설정 시 AdSlot 은 개발용 placeholder 를 렌더하며 실제 광고 요청을 하지 않음.
# 실제 광고는 AdSense 승인 + 운영(NODE_ENV=production) 환경에서만 로드됨.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID 예: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=""
NEXT_PUBLIC_ADSENSE_DASHBOARD_SLOT=""
NEXT_PUBLIC_ADSENSE_RESULT_SLOT=""
NEXT_PUBLIC_ADSENSE_MOCK_EXAM_SLOT=""
NEXT_PUBLIC_ADSENSE_REVIEW_SLOT=""

# Admin panel (/admin-auth)
# ADMIN_SECRET: bootstrap passphrase. Entering it signs in as the SUPER_ADMIN
#   account (created on first use), which can then add further admins that log
#   in with email + password. Compared server-side only.
# ADMIN_SESSION_SECRET: separate signing key for the admin session cookie,
#   kept apart from AUTH_SECRET so a leak of one doesn't compromise the other.
# ADMIN_BOOTSTRAP_EMAIL: email assigned to the bootstrap SUPER_ADMIN account
#   (optional; defaults to root@studyos.local). You can also sign in via the
#   credential form using this email and ADMIN_SECRET as the password.
# Generate the secrets with: openssl rand -base64 32
ADMIN_SECRET=""
ADMIN_SESSION_SECRET=""
ADMIN_BOOTSTRAP_EMAIL=""
