# Study OS Dev — Runtime Backend env. This service runs on a host WITH a
# Docker daemon (a VM/dedicated server — NOT Vercel, which has none). See
# README.md for the full architecture and deployment notes.

PORT=8088

# Shared secrets — generate with `openssl rand -base64 32`. Both MUST also be
# set on the StudyOS Web side (DEV_RUNTIME_SERVICE_TOKEN /
# DEV_RUNTIME_CAPABILITY_SECRET in the main app's env) — they must match
# exactly, or every request/connection will be rejected as unauthorized.
DEV_RUNTIME_SERVICE_TOKEN=""
DEV_RUNTIME_CAPABILITY_SECRET=""

# Image used for user workspace containers (built from docker/sandbox.Dockerfile).
DEV_WORKSPACE_IMAGE="studyos-dev-sandbox:latest"

# Resource limits per container (§9) — conservative v1 defaults.
DEV_CONTAINER_CPU=1
DEV_CONTAINER_MEMORY_MB=1024
DEV_CONTAINER_PIDS_LIMIT=128
DEV_CONTAINER_DISK_QUOTA_MB=2048

# Idle/process timeouts (minutes / seconds).
DEV_IDLE_TIMEOUT_MINUTES=30
DEV_PROCESS_TIMEOUT_SECONDS=600

# Terminal output throttling (§19) — bytes/sec forwarded to the browser, and
# the hard cap (bytes) before a runaway session is killed outright.
DEV_TERMINAL_OUTPUT_RATE=200000
DEV_TERMINAL_BUFFER_CAP=5000000

# How long a browser-facing capability token (terminal connect, preview) is
# valid for, in seconds. Short-lived by design — minted fresh per connection.
DEV_CAPABILITY_TOKEN_TTL=60
