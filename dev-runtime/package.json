{
  "name": "studyos-dev-runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Study OS Dev — Runtime Backend. Manages per-user Docker Linux containers, PTY terminal sessions, filesystem, processes, git, and preview proxying for /dev/*. Deployed SEPARATELY from the StudyOS Next.js app (Vercel has no Docker daemon) — see README.md.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "postinstall": "node scripts/fix-node-pty-permissions.mjs"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "node-pty": "^1.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.29",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  }
}
