generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js ────────────────────────────────────────────────────────────
// Shape required by @auth/prisma-adapter.

model User {
  id                       String             @id @default(cuid())
  name                     String?
  email                    String             @unique
  emailVerified            DateTime?
  image                    String?
  /// bcrypt hash; null for accounts that only ever signed in via Google.
  password                 String?
  timezone                 String             @default("Asia/Seoul")
  school                   String?
  /// Explicit UI language choice (validated supported locale, e.g. "en-US").
  /// null = AUTO (browser/IP auto-detection). See features/i18n.
  locale                   String?
  /// Set whenever the password changes (reset or future change flow). Sessions
  /// issued before this instant are treated as invalid by requireCurrentUser
  /// (JWT is stateless, so this is how a reset revokes older web sessions).
  passwordChangedAt        DateTime?
  /// Short profile status message ("상태 메시지"), shown on the profile card.
  /// Display nickname reuses `name` and avatar reuses `image` — no duplicate
  /// user table, per the profile system's extend-don't-duplicate design.
  bio                      String?
  /// Heartbeat timestamp for online presence. Updated while the user has an
  /// app tab open; online status (ONLINE/IDLE/OFFLINE) is derived from how
  /// stale this is. Null (or stale) means OFFLINE — set null on sign-out.
  lastSeenAt               DateTime?
  /// Set when an admin bans this account; null means active. The user's
  /// study data is never deleted on a ban — this is a reversible gate.
  bannedAt                 DateTime?
  banReason                String?
  /// When the new-user onboarding tutorial was completed (or skipped). Null =
  /// never finished → the tutorial auto-starts on next app load. Set once and
  /// never re-shown automatically; "튜토리얼 다시 보기" clears it back to null.
  /// Lives on User (not a cookie) so it is per-account and works for guests
  /// (a guest is a normal User row) — no separate onboarding model.
  tutorialCompletedAt      DateTime?
  /// Subscription plan + lifecycle gating feature access/limits (see
  /// features/billing). Kept as columns on User (not a separate Subscription
  /// table yet) — this Phase builds the Subscription/Plan/Entitlement structure
  /// only; a future billing layer flips these without touching any feature code.
  /// New users start TRIAL/TRIALING with a trialStartedAt (default now()); the
  /// trial window is 7 days and expiry is computed from trialEndsAt + server
  /// time. SECURITY: plan / subscriptionStatus / trialStartedAt / trialEndsAt
  /// all have UPDATE REVOKEd from the Supabase anon role in the migration, so a
  /// client can NEVER change its own plan or trial dates via the public REST
  /// endpoint — only server-side Prisma (owner role) can.
  plan                     Plan               @default(TRIAL)
  subscriptionStatus       SubscriptionStatus @default(TRIALING)
  trialStartedAt           DateTime?          @default(now())
  trialEndsAt              DateTime?
  /// Admin-only TEST override of the effective plan (features/billing/
  /// admin-override). Does NOT touch real billing: when
  /// adminPlanOverrideEnabled is true, entitlement resolution uses
  /// adminPlanOverride instead of `plan`. Only an admin can set these on THEIR
  /// OWN user row (email-matched), and UPDATE is REVOKEd from the Supabase anon
  /// role in the migration so a client can never self-grant a plan.
  adminPlanOverride        Plan?
  adminPlanOverrideEnabled Boolean            @default(false)
  /// Per-category opt-out for the notification system (features/notifications).
  /// Null/missing key = enabled (opt-out model, so shipping a brand-new category
  /// never silently mutes it for existing users). Shape: Record<NotificationCategory, boolean>.
  notificationPreferences  Json?
  /// Opt-out for the friend activity feed (features/social/activity): when
  /// false, this user's StudySession/Goal activity is excluded from friends'
  /// feeds. Distinct from notificationPreferences (that's about receiving
  /// alerts; this is about being visible in others' feeds) — defaults to true
  /// so shipping the feature doesn't silently hide existing users' activity.
  activitySharingEnabled   Boolean            @default(true)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  accounts         Account[]
  sessions         Session[]
  subjects         Subject[]
  todos            Todo[]
  goals            Goal[]
  studySessions    StudySession[]
  problemSets      ProblemSet[]
  problems         Problem[]
  wrongAnswers     WrongAnswer[]
  mockExams        MockExam[]
  examResults      ExamResult[]
  aiAnalyses       AiAnalysis[]
  problemAttempts  ProblemAttempt[]
  aiGenerationLogs AiGenerationLog[]
  studyBooks       StudyBook[]
  studyMaterials   StudyMaterial[]
  materialFolders  MaterialFolder[]

  sentFriendRequests      Friendship[]              @relation("FriendRequester")
  receivedFriendRequests  Friendship[]              @relation("FriendAddressee")
  conversationMemberships ConversationParticipant[]
  messages                Message[]
  messageReactions        MessageReaction[]
  blockedUsers            BlockedUser[]             @relation("Blocker")
  blockedByUsers          BlockedUser[]             @relation("Blocked")

  createdBattles       Battle[]            @relation("BattleCreator")
  battleParticipations BattleParticipant[]

  legalConsents    LegalConsent[]
  deletionRequests DataDeletionRequest[]
  auditLogs        AuditLog[]
  subscriptions    Subscription[]
  payments         Payment[]

  passwordResetTokens PasswordResetToken[]
  supportTickets      SupportTicket[]
  supportMessages     SupportMessage[]
  labFeedback         LabFeedback[]
  tutorConversations  TutorConversation[]
  devWorkspace        DevWorkspace?
  notifications       Notification[]

  growth        UserGrowth?
  xpEvents      GrowthXpEvent[]
  studyMissions StudyMission[]
}

/// Password reset tokens. The raw token is emailed to the user and NEVER stored;
/// only its SHA-256 hash is persisted, so a DB leak can't be used to reset
/// accounts. Short-lived (see features/auth/reset), single-use (usedAt), and
/// deleted/superseded on use. Prisma-only table: REVOKEd from the Supabase anon
/// role in its migration so the public REST endpoint can never read/forge one.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  /// SHA-256 hex of the random token. Unique so a lookup is by hash, not userId.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  /// Requesting IP — used only for rate limiting; never returned to any client.
  requestIp String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

enum SupportTicketType {
  BUG
  FEATURE_REQUEST
  PAYMENT
  ACCOUNT
  LEARNING
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  ANSWERED
  CLOSED
}

/// In-app support ticket. A conversation thread between a user and admins,
/// reusing the existing User + admin systems (no external helpdesk). Ownership
/// is enforced server-side by userId on every read/write.
model SupportTicket {
  id             String              @id @default(cuid())
  userId         String
  type           SupportTicketType
  title          String
  status         SupportTicketStatus @default(OPEN)
  /// Internal admin-only note. NEVER included in any user-facing response.
  adminNote      String?             @db.Text
  /// Last time the user opened the thread — used to derive "unread admin reply"
  /// for the notifications feed without a separate read-state table.
  userLastReadAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages SupportMessage[]

  @@index([userId])
  @@index([status])
  @@index([updatedAt])
}

/// One message in a support ticket thread. `authorRole` distinguishes user vs
/// admin (admins live in a separate AdminUser table, so senderId is the User id
/// for user messages and null for admin messages).
model SupportMessage {
  id         String   @id @default(cuid())
  ticketId   String
  /// "user" | "admin"
  authorRole String
  /// The User id for user messages; null for admin messages.
  senderId   String?
  content    String   @db.Text
  createdAt  DateTime @default(now())

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId])
}

/// A record that a user agreed to a specific legal document at a specific
/// version. documentType mirrors the LegalDocSlug in features/legal/documents
/// ("terms" | "privacy" | ...) and version mirrors that document's `version`,
/// so a bumped document version can require fresh consent without a schema
/// change. One row per (user, document, version) — re-agreeing to the same
/// version is idempotent. Prisma-only table: REVOKEd from the Supabase anon
/// role in its migration so a client can never read or forge another user's
/// consent through the public REST endpoint.
model LegalConsent {
  id           String    @id @default(cuid())
  userId       String
  documentType String
  version      String
  agreedAt     DateTime  @default(now())
  required     Boolean   @default(true)
  withdrawnAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentType, version])
  @@index([userId])
}

/// Tracks an account deletion request without retaining a user identifier
/// after the account has been removed. The row is intentionally SetNull-linked
/// so a completed/failed operational record can survive the user deletion.
model DataDeletionRequest {
  id            String    @id @default(cuid())
  userId        String?
  status        String    @default("PENDING")
  requestedAt   DateTime  @default(now())
  completedAt   DateTime?
  failureReason String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, requestedAt])
  @@index([status, requestedAt])
}

/// Minimal security audit events. Do not store request bodies, tokens, keys,
/// passwords, or free-form user content in this table.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([event, createdAt])
}

/// Payment-ready records only. No card number, CVC, or bank credential is
/// stored; provider-specific details remain with the future PG adapter.
model Subscription {
  id                 String    @id @default(cuid())
  userId             String?
  plan               Plan
  status             String    @default("INACTIVE")
  paymentProvider    String?
  externalId         String?   @unique
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextRenewalAt      DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId, status])
}

model Payment {
  id                    String    @id @default(cuid())
  userId                String?
  subscriptionId        String?
  amount                Int
  currency              String    @default("KRW")
  status                String    @default("PENDING")
  paymentProvider       String?
  externalTransactionId String?   @unique
  idempotencyKey        String?   @unique
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  refunds      Refund[]

  @@index([userId, createdAt])
  @@index([subscriptionId])
}

model Refund {
  id               String    @id @default(cuid())
  paymentId        String
  amount           Int
  status           String    @default("PENDING")
  reason           String?
  paymentProvider  String?
  externalRefundId String?   @unique
  processedAt      DateTime?
  createdAt        DateTime  @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Study domain ───────────────────────────────────────────────────────

model Subject {
  id        String   @id @default(cuid())
  userId    String
  name      String
  color     String   @default("#6366f1")
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos          Todo[]
  goals          Goal[]
  studySessions  StudySession[]
  problemSets    ProblemSet[]
  problems       Problem[]
  mockExams      MockExam[]
  studyBooks     StudyBook[]
  studyMaterials StudyMaterial[]
  studyMissions  StudyMission[]

  @@unique([userId, name])
  @@index([userId])
}

model Todo {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  title       String
  completed   Boolean   @default(false)
  completedAt DateTime?
  dueDate     DateTime  @default(now()) @db.Date
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate])
  @@index([subjectId])
}

/// A quantified daily target, e.g. "영어 단어 100개" (targetValue: 100, unit: "개").
model Goal {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  title        String
  targetValue  Int
  currentValue Int      @default(0)
  unit         String
  date         DateTime @default(now()) @db.Date
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, date])
}

/// A single timed study block, the source of truth for study-time stats and streaks.
model StudySession {
  id          String    @id @default(cuid())
  userId      String
  subjectId   String?
  startedAt   DateTime
  endedAt     DateTime?
  durationSec Int       @default(0)
  /// What kind of study block this was: FOCUS | PROBLEM | MOCK_EXAM | REVIEW |
  /// AI_TUTOR. Free-form string (not an enum) so new modes can be added
  /// without a migration; existing rows default to FOCUS.
  type        String    @default("FOCUS")
  createdAt   DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([subjectId])
}

/// One graded attempt at a single problem — the per-attempt learning log that
/// powers weakness analysis, accuracy trends, and solve-speed stats. Written
/// on every practice/exam/review submission (correct AND wrong), unlike
/// WrongAnswer which only tracks the currently-unresolved wrong set. Prisma-
/// only table: never exposed to the Supabase anon role (REVOKEd in migration).
model ProblemAttempt {
  id         String     @id @default(cuid())
  userId     String
  problemId  String
  /// Denormalized from Problem at write time so weakness aggregation never
  /// needs to join back through Problem (which may later be deleted).
  subjectId  String?
  unit       String?
  difficulty Difficulty
  isCorrect  Boolean
  /// Where the attempt came from: "practice" | "mock-exam" | "review".
  source     String
  /// The answer the user actually gave, in human-readable form (chosen choice
  /// content for MC, typed text for short-answer). Powers 오답 DNA analysis.
  answerText String?
  /// Wall-clock time the user spent on this attempt, if the client reported it.
  durationMs Int?
  createdAt  DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, subjectId])
  @@index([problemId])
}

/// One row per AI-generation attempt (problem set / mock exam), the server-side
/// source of truth for AI cost protection: daily quota, per-minute rate limit,
/// and concurrent-generation guard. Modeled like AdminLoginAttempt (a DB-backed
/// rate-limit/audit trail) since the app has no Redis — the quota critical
/// section serializes on a Postgres advisory lock, so no extra infra is needed.
/// A row is created `pending` when a request passes the quota gate, then flipped
/// to `success` / `validation_failed` / `error`. Only `success` (+ still-live
/// `pending`) consume daily quota, so failed/aborted calls don't burn quota.
/// Prisma-only table: REVOKEd from the Supabase anon role in its migration.
model AiGenerationLog {
  id        String   @id @default(cuid())
  userId    String
  ip        String?
  /// Which generator: "problem" | "mock-exam".
  kind      String
  /// "pending" | "success" | "validation_failed" | "error".
  status    String
  /// How many items were requested (problem count), for observability.
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status, createdAt])
}

// ─── 나만의 교재 (Study Books) ────────────────────────────────────────────
// A generated, personalized learning book. Reuses the existing Problem model
// for problem items (StudyBookItem.problemId) — NO duplicate problem structure.
// Prisma-only tables: REVOKEd from the Supabase anon role in their migration.

/// One generated study book. `type` is a free-form string (config lives in
/// features/study-books/types.ts) so new book types need no migration, matching
/// StudySession.type. `customInstructions` is the user's "나만의 교재 지침" —
/// treated as an UNTRUSTED user instruction that can shape style only; it never
/// overrides system/curriculum/safety/entitlement rules (enforced server-side in
/// the prompt builder + generation guard).
model StudyBook {
  id                 String     @id @default(cuid())
  userId             String
  title              String
  subjectId          String?
  /// Denormalized canonical subject name (from the curriculum taxonomy).
  subjectName        String
  grade              String
  unit               String?
  difficulty         Difficulty
  type               String
  /// Which QuestionType the book's problems use (MULTIPLE_CHOICE default,
  /// SHORT_ANSWER, or ESSAY) — separate from the book `type` (개념서 등).
  problemType        String     @default("MULTIPLE_CHOICE")
  customInstructions String?    @db.Text
  /// "generating" | "ready" | "failed"
  status             String     @default("generating")
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?           @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  chapters StudyBookChapter[]

  @@index([userId, createdAt])
}

model StudyBookChapter {
  id           String   @id @default(cuid())
  bookId       String
  title        String
  order        Int      @default(0)
  /// Concept explanation prose for the chapter.
  concept      String?  @db.Text
  /// Learning / review points for the chapter.
  reviewPoints String?  @db.Text
  createdAt    DateTime @default(now())

  book  StudyBook       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  items StudyBookItem[]

  @@index([bookId])
}

/// One item inside a chapter. Non-problem items (concept/example prose) store
/// their text in `content`; problem items reference an existing Problem row via
/// `problemId` (reused, not duplicated) so solving them flows through the normal
/// Learning-OS path.
model StudyBookItem {
  id        String   @id @default(cuid())
  chapterId String
  /// "concept" | "example" | "practice" | "application" | "advanced" | "review"
  kind      String
  order     Int      @default(0)
  content   String?  @db.Text
  problemId String?
  createdAt DateTime @default(now())

  chapter StudyBookChapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  problem Problem?         @relation(fields: [problemId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([problemId])
}

// ─── 자료실 (Study Materials) ──────────────────────────────────────────────
// Private per-user file library (PDF/TXT/MD/images), backed by Supabase
// Storage (a private bucket, see features/study-materials/storage.ts). All
// Storage mutations go through a server-only service-role client — the same
// "server bypasses RLS, app code is the real authorization gate" pattern this
// schema already uses for Prisma (DATABASE_URL) vs. the REVOKEd anon role.
// Prisma-only tables: REVOKEd from the Supabase anon role in their migration.

/// A folder in the user's material library. Self-referencing for nesting.
/// `onDelete: Cascade` on `parent` is a DB-level safety net only — the app
/// itself blocks deleting a non-empty folder (features/study-materials/actions.ts)
/// so that cascade should never actually fire in normal use.
model MaterialFolder {
  id        String   @id @default(cuid())
  userId    String
  parentId  String?
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    MaterialFolder?  @relation("MaterialFolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  MaterialFolder[] @relation("MaterialFolderChildren")
  materials StudyMaterial[]

  @@index([userId, parentId])
}

/// One uploaded file. `storageKey` is the Supabase Storage object path —
/// always server-generated as `{userId}/{materialId}/{sanitized filename}`,
/// never taken from client input directly (see features/study-materials/storage.ts) —
/// and unique so it doubles as the storage↔row consistency key. `status`
/// mirrors StudyBook's "generating"|"ready"|"failed" convention: a row is
/// written before the browser's direct-to-storage upload completes, and
/// confirmUpload() flips it to ready/failed once the object's *actual*
/// Storage-reported size/mimeType have been verified.
model StudyMaterial {
  id               String    @id @default(cuid())
  userId           String
  subjectId        String?
  folderId         String?
  name             String
  /// Derived server-side from the verified mimeType, never trusted from the
  /// client directly: "PDF" | "TXT" | "MD" | "IMAGE".
  type             String
  mimeType         String
  size             Int
  storageKey       String    @unique
  status           String    @default("pending")
  /// Reserved for a future AI document-parsing step (see spec §20/§21).
  /// Not populated by this phase.
  extractedText    String?   @db.Text
  processingStatus String?
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject?        @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  folder  MaterialFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@index([userId, folderId])
  @@index([userId, createdAt])
  @@index([subjectId])
}

// ─── AI problems (v2) ───────────────────────────────────────────────────

enum QuestionType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  /// 서술형 — requires the student to write out a process / reasoning / analysis.
  /// Not auto-graded (self-assessed against the model answer); still a normal
  /// Problem stored/scored through the shared Learning-OS path.
  ESSAY
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

/// Subscription plans, ascending capability. New users start on TRIAL (a 7-day
/// experience, not a permanent free tier). Central enum consumed by the
/// entitlement system (features/billing) — never compared inline across the app.
enum Plan {
  TRIAL
  PRO
  PREMIUM
}

/// Subscription lifecycle status, separate from `plan` so a future billing layer
/// can drive it (webhooks flip ACTIVE/CANCELED). For now it is TRIALING for new
/// users; TRIAL expiry is computed from trialEndsAt + server time, not trusted
/// solely from this column.
enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELED
}

/// A batch of AI-generated problems created together (one subject/unit/difficulty per set).
model ProblemSet {
  id         String     @id @default(cuid())
  userId     String
  subjectId  String?
  title      String
  unit       String?
  difficulty Difficulty
  createdAt  DateTime   @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?  @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  problems Problem[]

  @@index([userId])
}

model Problem {
  id              String       @id @default(cuid())
  userId          String
  problemSetId    String?
  subjectId       String?
  type            QuestionType
  difficulty      Difficulty
  unit            String?
  /// Canonical grade name at generation time (e.g. "중학교 1학년"), denormalized
  /// the same way StudyBook.grade already is. Null for problems generated
  /// before this field existed, and for flows that don't resolve a taxonomy
  /// grade (similar-problem regen without a source grade, mock exam, admin
  /// prompt test panel) — never backfilled/guessed.
  grade           String?
  prompt          String       @db.Text
  /// Canonical answer for SHORT_ANSWER; the MODEL answer for ESSAY.
  /// MULTIPLE_CHOICE uses Choice.isCorrect instead.
  answerText      String?
  explanation     String?      @db.Text
  /// ESSAY only: key scoring points / partial-credit criteria shown to the
  /// student for self-assessment. Null for MC / short-answer.
  scoringCriteria String?      @db.Text
  isFavorite      Boolean      @default(false)
  /// Normalized-content hash for the import pipeline's exact-duplicate detection
  /// + idempotency (features/problems/import). NULL for user-generated problems;
  /// set only on imported ones. `@unique` → Postgres allows many NULLs but keeps
  /// non-null fingerprints unique, so a re-sent/duplicate import can't double-insert.
  fingerprint     String?      @unique
  /// Origin of the problem: null/"user" = made by a user via AI generation;
  /// "import" = ingested into the shared 문제은행 via the import pipeline.
  source          String?
  /// The import batch this problem came in with (for tracing / import events).
  importBatchId   String?
  createdAt       DateTime     @default(now())

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemSet     ProblemSet?      @relation(fields: [problemSetId], references: [id], onDelete: SetNull)
  subject        Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  choices        Choice[]
  wrongAnswers   WrongAnswer[]
  examQuestions  ExamQuestion[]
  examAnswers    ExamAnswer[]
  attempts       ProblemAttempt[]
  studyBookItems StudyBookItem[]

  @@index([userId])
  // Composite for the per-user problem lists ordered by recency (getProblems,
  // 문제은행 own-scope, weak-problems pool): serves WHERE userId=? ORDER BY
  // createdAt without a separate sort. userId-only lookups still use it (prefix).
  @@index([userId, createdAt])
  @@index([subjectId])
  @@index([source])
}

model Choice {
  id        String  @id @default(cuid())
  problemId String
  label     String
  content   String
  isCorrect Boolean @default(false)

  problem     Problem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  examAnswers ExamAnswer[]

  @@index([problemId])
}

/// One row per problem the user currently has wrong; re-attempting the same
/// problem updates this row instead of creating a duplicate (see @@unique).
model WrongAnswer {
  id             String    @id @default(cuid())
  userId         String
  problemId      String
  source         String    @default("problem") // "problem" | "mock-exam"
  aiExplanation  String?   @db.Text
  resolved       Boolean   @default(false)
  /// ── 오답 DNA (Phase 4) ── structured "why it was wrong" from the AI, stored
  /// once on demand (analyzedAt set) so it is never re-generated on every read.
  errorType      String? // CALCULATION|CONCEPT|READING|FORMULA|CARELESS|UNKNOWN _ERROR
  errorConcept   String?
  errorReason    String?   @db.Text
  analyzedAt     DateTime?
  /// ── 자동 복습 (Phase 5, spaced repetition) ── reviewStage = number of
  /// successful reviews so far; it indexes REVIEW_INTERVALS_DAYS to set
  /// nextReviewAt (when this becomes "due" again). A correct review advances
  /// the stage; a wrong one resets it to 0. Graduating past the last interval
  /// flips `resolved` true and clears nextReviewAt.
  reviewStage    Int       @default(0)
  nextReviewAt   DateTime?
  lastReviewedAt DateTime?
  /// ── 적응형 복습 (Phase 6) ── per-item ease factor (SM-2 style). Modulates the
  /// base interval ladder so chronically-missed items keep shorter intervals and
  /// well-known items grow faster. Defaults to DEFAULT_EASE (2.5); existing rows
  /// inherit the default via the migration, so the fixed ladder is preserved.
  easeFactor     Float     @default(2.5)
  createdAt      DateTime  @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId, resolved])
  @@index([userId, nextReviewAt])
}

/// A generated exam: a fixed, ordered set of (always multiple-choice, for
/// OMR-style marking) problems with a time limit. Can be retaken — each
/// attempt is a separate ExamResult.
model MockExam {
  id           String   @id @default(cuid())
  userId       String
  subjectId    String?
  title        String
  style        String? // e.g. "평가원"
  timeLimitSec Int
  createdAt    DateTime @default(now())

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject   Subject?       @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  questions ExamQuestion[]
  results   ExamResult[]

  @@index([userId])
}

model ExamQuestion {
  id        String @id @default(cuid())
  examId    String
  problemId String
  order     Int    @default(0)

  exam    MockExam @relation(fields: [examId], references: [id], onDelete: Cascade)
  problem Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([examId, problemId])
  @@index([examId])
}

/// One attempt at a MockExam.
model ExamResult {
  id           String   @id @default(cuid())
  examId       String
  userId       String
  score        Int
  totalCount   Int
  correctCount Int
  durationSec  Int
  submittedAt  DateTime @default(now())

  exam    MockExam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers ExamAnswer[]

  @@index([userId])
  @@index([examId])
}

model ExamAnswer {
  id               String  @id @default(cuid())
  examResultId     String
  problemId        String
  selectedChoiceId String?
  answerText       String?
  isCorrect        Boolean

  examResult     ExamResult @relation(fields: [examResultId], references: [id], onDelete: Cascade)
  problem        Problem    @relation(fields: [problemId], references: [id], onDelete: Cascade)
  selectedChoice Choice?    @relation(fields: [selectedChoiceId], references: [id], onDelete: SetNull)

  @@index([examResultId])
}

/// AI-generated analysis, cached rather than recomputed on every dashboard
/// load — unlike other stats in this app, this one costs a real API call.
model AiAnalysis {
  id          String   @id @default(cuid())
  userId      String
  type        String // "weakness" | "weekly-report"
  content     String   @db.Text
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// ─── Social (v2) ──────────────────────────────────────────────────────────

/// A friend connection. Requester sends it as "pending"; the addressee
/// accepting flips it to "accepted". Declining or unfriending deletes the
/// row rather than tracking a "declined"/"removed" history.
model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  addresseeId String
  status      String // "pending" | "accepted"
  createdAt   DateTime @default(now())

  requester User @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId])
}

/// One-directional block: `blockerId` no longer wants to be contacted by
/// `blockedId` (new friend requests rejected; existing Friendship rows are
/// removed by the blockUser action itself, not by a DB trigger). Checked in
/// BOTH directions at the friend-request boundary — a blocked user can't
/// re-request, and a user who blocked someone can't accidentally re-request
/// them either.
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

/// A DM thread. MVP scope is 1:1 only, enforced in application code (exactly
/// two ConversationParticipant rows) rather than in the schema, so group
/// chats can be added later without a migration.
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  /// When this participant last opened the thread; messages after this from
  /// the other person are "unread" and feed the sidebar badge.
  lastReadAt     DateTime?
  /// Last time this participant was actively typing. Read-only signal, not a
  /// stored "is typing" boolean — the other participant's client derives
  /// "typing now" by checking this is within the last few seconds, the same
  /// stale-timestamp-as-state approach User.lastSeenAt already uses for
  /// ONLINE/IDLE/OFFLINE (features/profile/presence.ts). Written at most once
  /// per few seconds (client-side throttled in MessageInput), and picked up
  /// by the existing 4s conversation poll — no new write-per-keystroke, no
  /// new realtime transport.
  typingAt       DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String    @db.Text
  createdAt      DateTime  @default(now())
  /// Set when the sender has edited the content; null = never edited.
  editedAt       DateTime?
  /// Soft delete — content is cleared at delete time (not just hidden client-
  /// side) and a tombstone renders instead, but the row itself stays so
  /// reply chains pointing at it don't break.
  deletedAt      DateTime?
  replyToId      String?
  /// Optional shared-content attachment (e.g. sharing a Problem into the
  /// thread). `sharedId` deliberately has NO foreign key — it's a
  /// polymorphic reference whose target table depends on `sharedType`, the
  /// same "resolved at the app layer, not the DB" choice as
  /// Notification.actorId/metadata — so a new shareable type (a
  /// StudyMaterial, a StudyBook) is a pure addition later, no migration and
  /// no schema coupling to one specific table. `content` may be empty when a
  /// share has no caption; a message needs one of content/sharedType.
  sharedType     String?
  sharedId       String?

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]

  @@index([conversationId, createdAt])
  @@index([replyToId])
}

/// One row per (message, user, emoji) — a user can react to the same message
/// with several different emoji, but not the same emoji twice (toggling it
/// again removes the row). Restricted server-side to a fixed quick-reaction
/// set (features/social/reactions.ts), not arbitrary strings.
model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// A timed friend challenge over one metric (study_time/todo_count/
/// goal_progress). No stored status or score — both are computed at read
/// time (isActive from endAt vs now; each participant's score from their
/// StudySession/Todo/Goal rows in [startAt, endAt)), the same
/// don't-cache-what-you-can-derive call as Statistics and Ranking.
model Battle {
  id           String   @id @default(cuid())
  creatorId    String
  metric       String // "study_time" | "todo_count" | "goal_progress"
  durationDays Int
  startAt      DateTime @default(now())
  endAt        DateTime
  createdAt    DateTime @default(now())

  creator      User                @relation("BattleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants BattleParticipant[]
}

model BattleParticipant {
  id        String   @id @default(cuid())
  battleId  String
  userId    String
  status    String   @default("invited") // "invited" | "accepted" | "declined" | "left"
  createdAt DateTime @default(now())

  battle Battle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([battleId, userId])
  @@index([userId])
}

/// Central, app-wide notification feed (features/notifications). One row per
/// notification per recipient — even a broadcast (e.g. an admin announcement)
/// fans out into one row per user, so read-state is always per-user and a
/// single `markAsRead` never leaks into another user's inbox.
///
/// `type` is a plain string (not a Postgres enum), matching this schema's
/// existing convention for fields expected to grow over time (see
/// Friendship.status, Battle.metric, TutorMessage.role): adding a new
/// notification type is a TS union change (features/notifications/types.ts),
/// never a migration. Validated at the application boundary, not the DB.
///
/// `actorId` is nullable and intentionally has NO foreign key — the actor of
/// an admin-originated notification (e.g. a support reply) is an AdminUser,
/// a wholly separate table from User, so it cannot be a real FK to either
/// table uniformly. It is a plain informational id; never trust it for auth.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?   @db.Text
  isRead    Boolean   @default(false)
  readAt    DateTime?
  /// The user who caused this notification (friend request sender, DM sender,
  /// battle invite responder). Null for system/admin-originated notifications.
  actorId   String?
  /// Where a click should navigate, e.g. "/social" or "/social/:conversationId".
  /// Null when the notification has nothing to navigate to (e.g. a broadcast
  /// announcement whose full text is already shown inline).
  targetUrl String?
  /// Free-form, type-specific extra data (e.g. { conversationId, friendshipId,
  /// battleId }) — used for precise mark-as-read-by-target lookups without a
  /// migration per new type. Never trusted for authorization.
  metadata  Json?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notification Center list + unread badge: newest-first, optionally
  // filtered to unread only — both covered by one composite index.
  @@index([userId, isRead, createdAt])
  // Mark-as-read-by-target lookups (e.g. "mark this conversation's DM
  // notifications read") scan by type within a user's rows.
  @@index([userId, type, createdAt])
}

// ─── Admin panel ──────────────────────────────────────────────────────────
// Every model below is Prisma-only and explicitly REVOKEd from anon in its
// migration — Supabase auto-grants anon full CRUD on new public tables, and
// none of this may ever be reachable through the public REST endpoint.

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
}

/// A back-office operator, wholly separate from the end-user `User` table.
/// The ADMIN_SECRET passphrase bootstraps the first SUPER_ADMIN; every
/// admin after that is created by a SUPER_ADMIN and signs in with email +
/// password (bcrypt, same hashing as user Credentials auth).
model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  role         AdminRole @default(MODERATOR)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  createdBy      AdminUser?         @relation("AdminCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins  AdminUser[]        @relation("AdminCreatedBy")
  activityLogs   AdminActivityLog[]
  announcements  Announcement[]
  blockedIps     BlockedIp[]
  promptVersions PromptVersion[]

  @@index([role])
}

/// Every /admin-auth attempt (success and failure), used both to rate-limit
/// by IP and as the security-page audit trail. `email` records which account
/// was tried (null for passphrase attempts).
model AdminLoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  email     String?
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Append-only audit trail of admin actions (logins, user/admin management,
/// announcements, permission changes, system toggles, captured errors).
model AdminActivityLog {
  id         String   @id @default(cuid())
  adminId    String?
  action     String
  targetType String?
  targetId   String?
  detail     String?  @db.Text
  ip         String?
  createdAt  DateTime @default(now())

  admin AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([adminId, createdAt])
  @@index([action])
}

/// A site-wide notice. Draft while publishedAt is null; scheduledAt lets a
/// draft go live at a future time; isPinned floats it to the top.
model Announcement {
  id          String    @id @default(cuid())
  title       String
  body        String    @db.Text
  authorId    String?
  isPinned    Boolean   @default(false)
  publishedAt DateTime?
  scheduledAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author AdminUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([isPinned, publishedAt])
}

/// An IP address blocked from admin sign-in, checked before login. Supports
/// permanent and time-limited bans; `active` allows soft-disable without
/// losing the record. The effective block = active && (permanent || expiresAt
/// in the future).
model BlockedIp {
  id          String    @id @default(cuid())
  ip          String    @unique
  reason      String?
  createdById String?
  permanent   Boolean   @default(true)
  expiresAt   DateTime?
  active      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([ip])
  @@index([active])
}

/// Single-row maintenance state. Kept in its own table (not SystemSetting)
/// because it must be readable at the Edge (middleware) via the anon Supabase
/// role — it's public "we're down" info — while writes go through Prisma. One
/// fixed row (id = "singleton") guarantees a single active state.
model Maintenance {
  id          String   @id @default("singleton")
  enabled     Boolean  @default(false)
  title       String?
  message     String?
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Key/value store for runtime toggles (AI on/off, model selection, admin
/// session epoch). One row per setting; JSON-encoded value in `value`.
model SystemSetting {
  key         String   @id
  value       String   @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// ─── AI Prompt management ─────────────────────────────────────────────────
// Prompts live in the DB, not in code. Each logical prompt (one per `type`)
// keeps an append-only version history; `activeVersion` points at the version
// the AI engine actually uses. Editing never overwrites — it appends a new
// version — so any prior version can be re-activated (rollback).

model Prompt {
  id            String   @id @default(cuid())
  type          String   @unique
  title         String
  description   String?
  enabled       Boolean  @default(true)
  activeVersion Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  versions PromptVersion[]

  @@index([type])
}

model PromptVersion {
  id          String   @id @default(cuid())
  promptId    String
  version     Int
  content     String   @db.Text
  note        String?
  createdById String?
  ip          String?
  createdAt   DateTime @default(now())

  prompt    Prompt     @relation(fields: [promptId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([promptId, version])
  @@index([promptId])
}

// ─── 실험실(Lab) ───────────────────────────────────────────────────────────
// Feature definitions live in code (features/lab/registry). These tables hold
// only the admin-toggleable enabled flag + lightweight analytics counters and
// per-user feedback — no duplicate feature-flag/analytics system.

enum LabFeedbackVote {
  LIKE
  DISLIKE
}

/// Per-feature runtime state + aggregate analytics. `key` matches a registry key.
/// A missing row means "enabled by default" (registry decides the rest).
model LabFeatureState {
  key         String   @id
  enabled     Boolean  @default(true)
  impressions Int      @default(0)
  uses        Int      @default(0)
  successes   Int      @default(0)
  failures    Int      @default(0)
  updatedAt   DateTime @default(now()) @updatedAt
}

/// One like/dislike per user per feature (upsert on the unique pair).
model LabFeedback {
  id         String          @id @default(cuid())
  userId     String
  featureKey String
  vote       LabFeedbackVote
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, featureKey])
  @@index([featureKey])
}

// ─── AI 1:1 과외 선생님(Tutor) ─────────────────────────────────────────────
// Minimal tutor-specific chat models. The social Conversation/Message tables are
// user-to-user DMs, so they are NOT reused here; the tutor thread is a
// student↔AI conversation with subject/grade context. Message text lives once
// in TutorMessage (no duplication). Owner-scoped by userId on every read/write.

model TutorConversation {
  id        String   @id @default(cuid())
  userId    String
  /// Subject key from features/tutor/subjects (수학/영어/…). Free-form string so
  /// a new subject is a config change, not a migration.
  subject   String
  /// Grade-level key for difficulty tuning (features/tutor/grades).
  grade     String
  title     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages TutorMessage[]

  @@index([userId, updatedAt])
}

model TutorMessage {
  id             String   @id @default(cuid())
  conversationId String
  /// "user" | "assistant"
  role           String
  content        String   @db.Text
  /// Optional structured extras (e.g. { understanding: "..." }) — never PII.
  metadata       Json?
  createdAt      DateTime @default(now())

  conversation TutorConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// ── Study OS Dev (v1) ── one personal dev workspace per user. v1 ships the
/// product shell only: this row is real and persists across reloads, but no
/// container backend is wired up yet (features/dev/container-manager returns
/// "unavailable" for every operation) — status therefore stays NOT_PROVISIONED
/// until a real container/PTY backend is integrated. `status` is a free-form
/// string (same convention as StudySession.type) so new lifecycle states don't
/// need a migration. `settings` is user preferences only (terminal font size,
/// theme, shell, idle timeout, …), never container runtime state — validated
/// against an explicit whitelist (features/dev/schema.ts) before every write.
model DevWorkspace {
  id           String    @id @default(cuid())
  userId       String
  name         String
  /// NOT_PROVISIONED | CREATING | READY | RUNNING | IDLE | STOPPED | ERROR
  status       String    @default("NOT_PROVISIONED")
  containerId  String?
  runtime      String?
  lastActiveAt DateTime?
  settings     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
  @@index([userId])
}

// ─── Growth + Mission System (v1) ──────────────────────────────────────────
// "공부할수록 성장하는 Learning OS": every learning activity (study time,
// problem solving, wrong-answer review, goal completion, mission completion)
// feeds one XP ledger; level/progress is derived from it via pure functions
// (features/growth/level.ts) — never stored, so the level curve can change
// without a migration and server/client always agree. Streak is deliberately
// NOT duplicated here: the Growth Summary (features/growth/queries.ts) calls
// the EXISTING getStreakStats() (study-sessions/queries.ts, itself derived
// from StudySession) instead of storing a second counter that could drift
// from the one StudySession already owns.
//
// This is unrelated to features/learning/mission.ts's "오늘의 Study Mission"
// board — that one is a fully computed, non-persisted, non-rewarded weakness
// suggestion (recomputed from ProblemAttempt/WrongAnswer on every render,
// nothing stored). StudyMission below is a real, persisted, completable,
// XP-rewarding entity the user (or a future system source) creates — a
// different concept that intentionally does not touch or replace that board.

/// One row per user. `totalXp` is a CACHED aggregate of GrowthXpEvent (the
/// real source of truth) so reading a user's XP/level is O(1) instead of
/// summing every event on every page load. Every write to totalXp happens in
/// the SAME transaction as the GrowthXpEvent it corresponds to (see
/// features/growth/xp-service.ts), so the two can never drift; if that's ever
/// in doubt, totalXp is fully recomputable via
/// `SELECT SUM(amount) FROM "GrowthXpEvent" WHERE "userId" = ...`.
model UserGrowth {
  id        String   @id @default(cuid())
  userId    String   @unique
  totalXp   Int      @default(0)
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Immutable, append-only XP ledger — the source of truth for totalXp and the
/// idempotency boundary that makes XP un-farmable (double-submit, refresh
/// replay, same-problem-spam). `type` is a plain string (not a Postgres enum),
/// matching this schema's convention for fields expected to grow (see
/// StudySession.type, Friendship.status): a new XP source is a TS union
/// change, never a migration.
///
/// `sourceId` MUST uniquely identify the one real-world activity this XP is
/// for (a StudySession id, a "<problemId>:<YYYY-MM-DD>" key, a
/// "<wrongAnswerId>:<newReviewStage>" key, a Goal id, a Mission id, or an
/// "all-missions:<YYYY-MM-DD>" bonus key) — @@unique below is what actually
/// prevents granting the same XP twice. Deliberately NON-nullable (unlike a
/// typical "sourceId?" sketch): a null sourceId would be exempt from the
/// unique constraint in Postgres (NULL <> NULL), silently defeating the one
/// guarantee this table exists for.
model GrowthXpEvent {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  /// "MISSION_COMPLETED" | "STUDY_TIME" | "REVIEW_COMPLETED" |
  /// "PROBLEM_SOLVED" | "GOAL_COMPLETED" | "ALL_MISSIONS_BONUS"
  type      String
  sourceId  String
  /// Free-form, type-specific context for the activity feed (e.g. subject
  /// name, minutes studied). Never used for authorization or recomputation.
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, sourceId])
  @@index([userId, createdAt])
}

/// A goal-shaped unit of learning work that earns XP on completion. `type` /
/// `source` / `status` are plain strings (not Postgres enums), matching this
/// schema's convention for fields expected to grow (see StudySession.type,
/// Friendship.status) — adding a new mission type is a TS union change, never
/// a migration.
model StudyMission {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  /// "STUDY_TIME" | "PROBLEM_COUNT" | "REVIEW_COUNT" | "GOAL" | "CUSTOM"
  type         String
  /// "MANUAL" | "GOAL" | "SYSTEM" — who/what created this mission. Only
  /// MANUAL is actually produced in v1; GOAL/SYSTEM are reserved for a future
  /// Goal-sync or auto-suggested daily set (never AI-generated per this
  /// phase's explicit scope).
  source       String    @default("MANUAL")
  subjectId    String?
  /// STUDY_TIME is tracked in whole minutes; PROBLEM_COUNT/REVIEW_COUNT in
  /// item counts; CUSTOM defaults to a single manual-complete step (1).
  targetValue  Int
  currentValue Int       @default(0)
  /// "PENDING" | "IN_PROGRESS" | "COMPLETED" | "CANCELLED" | "EXPIRED"
  status       String    @default("PENDING")
  /// XP granted on completion, captured at creation time so a later XP-policy
  /// change never retroactively alters an already-in-flight mission's reward.
  xpReward     Int       @default(50)
  dueAt        DateTime?
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject Subject? @relation(fields: [subjectId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, dueAt])
}
